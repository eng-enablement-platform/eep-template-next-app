{
  "version": 3,
  "remove": [
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "version.txt",
    "release-please-config.json",
    ".release-please-manifest.json",
    ".github/workflows/release-please.yml"
  ],
  "readme": "README.md",
  "features": [
    {
      "id": "docs",
      "prompt": "Include the docs site (Fumadocs, in docs/)?",
      "default": false,
      "remove": ["docs/"],
      "scripts": ["dev:docs", "dev:all", "build:docs", "build:all"]
    },
    {
      "id": "diagrams",
      "prompt": "Include diagrams-as-code (Python, in diagrams/)?",
      "default": true,
      "remove": ["diagrams/"],
      "setup": {
        "title": "Install diagram dependencies",
        "command": ["uv", "sync"],
        "cwd": "diagrams",
        "missing": "Diagrams need uv (it downloads Python for you) - see https://docs.astral.sh/uv/getting-started/installation/, then `cd diagrams && uv sync`."
      }
    },
    {
      "id": "devcontainer",
      "prompt": "Include the VS Code dev container (.devcontainer/)?",
      "default": true,
      "remove": [".devcontainer/"]
    }
  ]
}
