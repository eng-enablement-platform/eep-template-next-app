{
  // ─── EEP Template — Next.js devcontainer ────────────────────────────────────
  // Opens a zero-setup environment in VS Code / Cursor / GitHub Codespaces.
  //
  // What you get:
  //   • Node 24 + pnpm (matches .nvmrc and engines field)
  //   • uv + Graphviz, with Python 3.14 fetched by uv  (for regenerating diagrams/)
  //   • Postgres 17 running inside the container (no Docker Compose)
  //   • Zsh + Oh My Zsh with autosuggestions, syntax-highlighting, history-search
  //   • Full VS Code extension set pre-installed
  //
  // First-time setup after the container starts:
  //   1. Copy .env.local_template → .env.local and fill in your Clerk keys.
  //   2. DATABASE_URL is auto-overridden to point at the in-container Postgres —
  //      no change needed for local dev.
  //   3. Run `pnpm dev` to start the app on :3000.
  //
  // Architecture note — why no dockerComposeFile:
  //   Rancher Desktop runs Docker in a Linux VM and resolves relative paths in
  //   compose files from that VM's CWD, not the host repo root. This causes the
  //   entire repos folder to be mounted instead of just this repo. Using a
  //   single-container devcontainer with Postgres installed inside it (in
  //   .devcontainer/Dockerfile, started by post-start.sh) avoids this
  //   entirely — the Dev Containers extension always mounts the correct
  //   workspace folder regardless of Docker runtime.
  // ────────────────────────────────────────────────────────────────────────────

  "name": "eep-template-next-app",

  // Single-container mode — no dockerComposeFile. The Dev Containers extension
  // handles the workspace mount correctly on all runtimes (Docker Desktop,
  // Rancher Desktop, Codespaces).
  // Postgres and Graphviz are installed as root in the Dockerfile (avoids sudo
  // password prompts that occur when installing via postCreateCommand).
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Node 24 + pnpm via corepack
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.21.0",
      "pnpmVersion": "latest"
    },
    // Zsh + Oh My Zsh (terminal UX)
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true,
      // A full apt upgrade on every build is slow; the base image is kept
      // current by bumping its tag instead.
      "upgradePackages": false
    }
  },

  // node_modules lives in a Docker volume, not the shared workspace folder.
  // Otherwise the container's `pnpm install` overwrites the host's
  // node_modules with Linux native binaries (breaking tests/builds on macOS
  // and Windows), and a volume is also much faster than a bind mount on macOS.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  // DATABASE_URL for the in-container Postgres (localhost inside the container).
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/app"
  },

  // Runs once when the container is first created, BEFORE VS Code attaches -
  // VS Code waits for it, so extensions find node_modules on first load.
  "onCreateCommand": "bash .devcontainer/on-create.sh",

  // Runs once when the container is first created, after VS Code attaches.
  "postCreateCommand": "zsh .devcontainer/post-create.sh",

  // Runs every time the container starts.
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        // TypeScript / JS
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        // Tailwind
        "bradlc.vscode-tailwindcss",
        // Testing
        "ms-playwright.playwright",
        "vitest.explorer",
        // Git
        "eamodio.gitlens",
        // Python (for diagrams/)
        "ms-python.python",
        "charliermarsh.ruff",
        // Icons + theme
        "pkief.material-icon-theme",
        // Misc DX
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },

  "remoteUser": "vscode"
}
